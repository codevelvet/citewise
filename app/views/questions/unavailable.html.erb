<% content_for :title, "Citewise: question not available" %>

<main class="mx-auto max-w-[720px] px-6 pt-16 pb-16">
  <%# Never shows the question's text: it may not be this visitor's. %>
  <div class="flex flex-col gap-2 rounded-xl border border-line bg-white p-8">
    <h1 class="text-[22px] font-semibold">This question isn't available</h1>
    <p class="text-ink-soft">Questions can only be seen in the browser that asked them, until that browser is closed. If this was your question, you can ask it again.</p>
    <div class="mt-4">
      <%= link_to "Ask a question", new_question_path,
            class: "inline-flex h-11 items-center rounded-lg bg-ink px-5 font-semibold text-white no-underline" %>
    </div>
  </div>
</main>
