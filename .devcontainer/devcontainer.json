// For format details, see https://containers.dev/implementors/json_reference/.
// For config options, see the README at: https://github.com/devcontainers/templates/tree/main/src/ruby
{
  "name": "citewise",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

   // CRITICAL: Force the tool (VSCode) to respect your Dockerfile's ENTRYPOINT
  "overrideCommand": false,

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/rails/devcontainer/features/postgres-client": {}
  },

  "containerEnv": {
    "DB_HOST": "postgres",
    "DB_USER": "citewise_app",
    "DB_PASSWORD": "citewise-local-development",
    "DB_TEMPLATE": "citewise_vector_template"
  },

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "Shopify.ruby-lsp"],
      "settings": {
        "remote.autoForwardPorts": false
      }
    }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // Do not forward the database port
  "forwardPorts": [3000],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // Uncomment to connect as root instead. More info: https://containers.dev/implementors/json_reference/#remoteUser.
  // "remoteUser": "root",

  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },


  // Use 'postCreateCommand' to run commands after the container is created.
  // Note: runs in parallel with entrypoint hence the wait
  "postCreateCommand": "sh /usr/local/bin/citewise-setup-when-rubygems-ready.sh",
  "waitFor": "postCreateCommand",

  // Tripwires: warn if the SSH agent leaks in or the firewall isn't active
  "postAttachCommand": "ssh-add -l >/dev/null 2>&1 && echo '⚠️  WARNING: SSH agent has keys inside the container'; curl -s --max-time 3 https://example.com >/dev/null 2>&1 && echo '⚠️  WARNING: FIREWALL NOT ACTIVE' || true"

}
